{
  "expo": {
    "name": "Ubenplay",
    "slug": "ubenplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ubenclick.play"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ubenclick.play"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "websiteUrl": "https://play.uben.in/",
      "enableNavigation": true,
      "navItems": [
        {
          "id": "1",
          "label": "Home",
          "url": "/home",
          "icon": "home"
        },
        {
          "id": "1767794573603",
          "label": "Import Video",
          "url": "/import-video",
          "icon": "info"
        },
        {
          "id": "1767794726417",
          "label": "Account",
          "url": "/login",
          "icon": "user"
        }
      ]
    }
  }
}