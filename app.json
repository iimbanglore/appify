{
  "expo": {
    "name": "Favstore24",
    "slug": "favstore24",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.favstore.shopp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.favstore.shopp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "websiteUrl": "https://favstore24.com/en",
      "enableNavigation": true,
      "navItems": [
        {
          "id": "1",
          "label": "Home",
          "url": "/",
          "icon": "home"
        },
        {
          "id": "1768487366525",
          "label": "Cart",
          "url": "/cart",
          "icon": "cart"
        },
        {
          "id": "1768487367355",
          "label": "Account",
          "url": "/account",
          "icon": "user"
        }
      ]
    }
  }
}