{
  "expo": {
    "name": "Tinkklebox",
    "slug": "tinkklebox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tinnklebox.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tinnklebox.shop"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "websiteUrl": "https://tinkklebox.com/",
      "enableNavigation": true,
      "navItems": [
        {
          "id": "1",
          "label": "Home",
          "url": "/",
          "icon": "home"
        },
        {
          "id": "1768593298211",
          "label": "Profile",
          "url": "https://account.tinkklebox.com/?locale=en&region_country=IN",
          "icon": "user"
        },
        {
          "id": "1768593299990",
          "label": "Collection",
          "url": "/collections",
          "icon": "heart"
        },
        {
          "id": "1768593379346",
          "label": "Cart",
          "url": "/cart",
          "icon": "cart"
        }
      ]
    }
  }
}