        },
        {
          "id": "1767887849044",
          "label": "Trend",
          "url": "/channel/top-trend",
          "icon": "menu"
        },
        {
          "id": "1767887897551",
          "label": "Songtap",
          "url": "https://songtap.uben.in/",
          "icon": "home"
        }
      ]
    }
